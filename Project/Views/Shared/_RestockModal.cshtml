<div class="modal fade" id="restockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="restockModalForm" asp-controller="Fabrics" asp-action="Restock" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="restockModalFabricId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-box-arrow-in-up text-success me-2"></i>Restock <span id="restockModalItemName">item</span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Current stock: <strong id="restockModalCurrentStock">—</strong></label>
                    <label class="form-label mt-2" for="restockModalQuantity">Quantity to add</label>
                    <input type="number" step="0.01" min="0.01" name="quantity" id="restockModalQuantity" class="form-control" placeholder="e.g. 50" required />
                    <label class="form-label mt-3" for="restockModalReason">Note (optional)</label>
                    <input type="text" maxlength="250" name="reason" id="restockModalReason" class="form-control" placeholder="e.g. Supplier delivery" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="bi bi-plus-lg me-1"></i>Add to stock</button>
                </div>
            </form>
        </div>
    </div>
</div>
