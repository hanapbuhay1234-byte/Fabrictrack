<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FabriTrack</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Inter:wght@400;500;600,700&display=swap" rel="stylesheet">
    <script>
        // Apply saved theme before CSS to avoid flash
        (function(){
            try{
                var saved = localStorage.getItem('ft-theme');
                if(!saved){
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    saved = prefersDark ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-bs-theme', saved);
            }catch(e){}
        })();
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        string CurrentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        string CurrentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        string NavClass(string controller, params string[] excludeActions)
        {
            if (!CurrentController.Equals(controller, StringComparison.OrdinalIgnoreCase)) return "nav-link";
            foreach(var a in excludeActions){ if (CurrentAction.Equals(a, StringComparison.OrdinalIgnoreCase)) return "nav-link"; }
            return "nav-link active";
        }
        string NavClassAct(string controller, string action) =>
            (CurrentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && CurrentAction.Equals(action, StringComparison.OrdinalIgnoreCase)) ? "nav-link active" : "nav-link";
    }
    <div class="app-shell">
        <div id="sidebarBackdrop"></div>
        <aside class="sidebar" id="sidebar">
            <div class="brand">
                <i class="bi bi-scissors"></i>
                <span>FabriTrack</span>
            </div>

            <div class="nav-section-label">Overview</div>
            <a class="@NavClass("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="@NavClass("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Sales Analytics</a>

            <div class="nav-section-label">Inventory</div>
            <a class="@NavClass("Fabrics", "LowStock")" asp-controller="Fabrics" asp-action="Index"><i class="bi bi-boxes"></i> Product Inventory</a>
            <a class="@NavClassAct("Fabrics","LowStock")" asp-controller="Fabrics" asp-action="LowStock"><i class="bi bi-exclamation-triangle"></i> Stock alerts</a>
            <a class="@NavClass("Categories")" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a>
            <a class="@NavClass("Suppliers")" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i> Suppliers</a>

            @if (User.IsInRole(FabriTrack.Models.Roles.Admin))
            {
                <div class="nav-section-label">Administration</div>
                <a class="@NavClass("UserManagement")" asp-controller="UserManagement" asp-action="Index"><i class="bi bi-person-gear"></i> User management</a>
            }

            <div class="nav-section-label">Sales</div>
            <a class="nav-link" asp-controller="Sales" asp-action="Create"><i class="bi bi-cart-plus"></i> New sale</a>
            <a class="@NavClassAct("Sales","Index")" asp-controller="Sales" asp-action="Index"><i class="bi bi-receipt"></i> Sales history</a>
            <a class="@NavClass("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a>

            <div class="sidebar-footer">&copy; @DateTime.Now.Year FabriTrack</div>
        </aside>

        <div class="app-content">
            <header class="topbar">
                <button id="sidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none" type="button" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="d-flex align-items-center gap-2">
                    <button id="themeToggle" class="btn btn-sm btn-outline-secondary" type="button" aria-label="Toggle theme" title="Toggle theme">
                        <i class="bi bi-moon"></i>
                    </button>
                    <partial name="_LoginPartial" />
                </div>
            </header>
            <div id="loadingBar"></div>

            <main role="main" class="container-fluid py-4">
                @RenderBody()
            </main>

            <footer class="border-top footer py-3 px-4">
                &copy; @DateTime.Now.Year FabriTrack — product inventory &amp; sales
            </footer>
        </div>
    </div>

    <div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true"></div>

    @if (TempData["Success"] != null)
    {
        <div id="toast-success-data" data-toast-message="@TempData["Success"]" data-toast-type="success" hidden></div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toast-error-data" data-toast-message="@TempData["Error"]" data-toast-type="danger" hidden></div>
    }

    <partial name="_DeleteModal" />
    <partial name="_RestockModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
