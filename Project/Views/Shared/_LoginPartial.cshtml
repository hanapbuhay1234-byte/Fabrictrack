@using Microsoft.AspNetCore.Identity
@using FabriTrack.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav flex-row align-items-center gap-2 mb-0">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link px-2 d-flex align-items-center" style="color: var(--color-ink); gap:0.5rem;">
            <i class="bi bi-person-circle me-1"></i>
            @{
                // Prefer FullName when available, otherwise fall back to email/user name
                var user = UserManager.GetUserAsync(User).GetAwaiter().GetResult();
                var displayName = user?.FullName;
                if (string.IsNullOrWhiteSpace(displayName)) displayName = user?.Email ?? User.Identity?.Name;
                var roles = user != null ? UserManager.GetRolesAsync(user).GetAwaiter().GetResult() : new List<string>();
            }
            <span>@displayName</span>
            @if (roles != null && roles.Count > 0)
            {
                <span class="badge bg-secondary ms-2">@roles[0]</span>
            }
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </a>
    </li>
}
</ul>
