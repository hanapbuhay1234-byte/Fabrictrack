@using FabriTrack.Models
@model FabriTrack.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-card">
    <div class="error-icon mb-3"><i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:2rem"></i></div>
    <h1 class="h4 mb-2">Something went wrong</h1>
    <p class="text-muted mb-3">We couldn't complete your request. The issue has been recorded — please try again or contact the administrator if the problem persists.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }

    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to dashboard</a>
    </div>
</div>
