@model FabriTrack.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}

<h2 class="mb-3"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete category</h2>
<div class="confirm-card">
    <p class="mb-0">Delete <strong>@Model.Name</strong>? Fabrics using this category must be reassigned first.</p>
</div>
<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="CategoryId" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Delete</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
</form>