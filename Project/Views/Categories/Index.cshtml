@model IEnumerable<FabriTrack.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <h2><i class="bi bi-tags me-2"></i>Categories</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add category</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-inbox display-6 d-block mb-2"></i>
        <h5 class="mb-2">No categories yet</h5>
        <p class="text-muted mb-3">Organize fabrics with categories to make inventory browsing easier.</p>
        @if (User.IsInRole("Admin")) {
            <a asp-action="Create" class="btn btn-primary">Add category</a>
        }
    </div>
}
else
{
    <div class="table-container">
        <table class="table data-table" data-page-size="10">
            <thead><tr><th data-sort>Name</th><th data-sort>Description</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.Description</td>
                        <td>
                            <a class="btn btn-sm btn-outline-warning" asp-action="Edit" asp-route-id="@c.CategoryId"><i class="bi bi-pencil"></i></a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-form-action="@Url.Action("Delete", "Categories", new { id = c.CategoryId })" data-item-name="@c.Name">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
