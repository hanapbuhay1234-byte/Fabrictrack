@model IEnumerable<FabriTrack.Models.Fabric>
{
    ViewData["Title"] = "Out of stock";
}

<div class="page-header">
    <h2><i class="bi bi-exclamation-triangle text-danger me-2"></i>Out of stock</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to inventory</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state text-center py-5">
        <i class="bi bi-check-circle display-6 d-block mb-2 text-success"></i>
        <h5 class="mb-2">Nothing is out of stock right now</h5>
        <p class="text-muted mb-3">All fabrics currently have stock above zero.</p>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to inventory</a>
    </div>
}
else
{
    <div class="table-container">
        <table class="table data-table" data-page-size="10">
            <thead><tr><th data-sort>Name</th><th data-sort>Category</th><th data-sort>Stock</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Name</td>
                        <td>@f.Category?.Name</td>
                        <td><span class="badge badge-low">@String.Format("{0:0.##}", f.StockQuantity) @f.Unit</span></td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <button type="button" class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#restockModal"
                                        data-fabric-id="@f.FabricId" data-item-name="@f.Name" data-current-stock="@f.StockQuantity @f.Unit">
                                    <i class="bi bi-box-arrow-in-up me-1"></i>Restock
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
