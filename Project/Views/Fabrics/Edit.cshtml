@model FabriTrack.Models.Fabric
@{
    ViewData["Title"] = "Edit Product";
    var imageUrl = Html.NormalizeImageUrl(Model.ImageUrl);
}

<div class="inventory-form-heading">
    <a asp-action="Details" asp-route-id="@Model.FabricId" class="inventory-back-link"><i class="bi bi-arrow-left"></i> Back to product</a>
    <div class="inventory-form-title">
        <span class="inventory-form-title-icon"><i class="bi bi-pencil-square"></i></span>
        <div>
            <h2>Edit product</h2>
            <p>Update product details, selling price, and reorder settings.</p>
        </div>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="inventory-editor">
    <input type="hidden" asp-for="FabricId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="inventory-editor-layout">
        <div class="inventory-editor-main">
            <section class="inventory-form-section">
                <div class="inventory-section-heading">
                    <span class="inventory-section-icon"><i class="bi bi-tag"></i></span>
                    <div><h3>Product identity</h3><p>Keep SKU and variant details clear for staff.</p></div>
                </div>
                <div class="inventory-field-grid">
                    <div class="inventory-field">
                        <label asp-for="Name" class="form-label">Product name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="Sku" class="form-label">SKU <span class="text-danger">*</span></label>
                        <input asp-for="Sku" class="form-control" />
                        <span asp-validation-for="Sku" class="text-danger"></span>
                        <small>SKU must be unique. Historical sales retain their original SKU.</small>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="CategoryId" class="form-label">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="SupplierId" class="form-label">Supplier <span class="text-danger">*</span></label>
                        <select asp-for="SupplierId" class="form-select" asp-items="ViewBag.SupplierId"></select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="Color" class="form-label">Color / variant</label>
                        <input asp-for="Color" class="form-control" placeholder="e.g. Navy blue" />
                        <small>Each color variant has a separate stock record.</small>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="Pattern" class="form-label">Pattern</label>
                        <input asp-for="Pattern" class="form-control" placeholder="e.g. Herringbone" />
                    </div>
                </div>
            </section>

            <section class="inventory-form-section">
                <div class="inventory-section-heading">
                    <span class="inventory-section-icon"><i class="bi bi-currency-exchange"></i></span>
                    <div><h3>Pricing and stock settings</h3><p>Stock quantity changes are recorded separately in the inventory ledger.</p></div>
                </div>
                <div class="inventory-field-grid inventory-field-grid-three">
                    <div class="inventory-field">
                        <label asp-for="Unit" class="form-label">Unit <span class="text-danger">*</span></label>
                        <select asp-for="Unit" class="form-select" asp-items="ViewBag.Units"></select>
                        <span asp-validation-for="Unit" class="text-danger"></span>
                        <small>Rolls and pieces use whole quantities.</small>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="PricePerUnit" class="form-label">Selling price <span class="text-danger">*</span></label>
                        <div class="input-group"><span class="input-group-text">₱</span><input asp-for="PricePerUnit" class="form-control" type="number" min="0" step="0.01" /></div>
                        <span asp-validation-for="PricePerUnit" class="text-danger"></span>
                    </div>
                    <div class="inventory-field">
                        <label asp-for="ReorderLevel" class="form-label">Reorder level</label>
                        <input asp-for="ReorderLevel" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                        <small>Alert when stock reaches this amount.</small>
                    </div>
                </div>
                <div class="inventory-current-stock">
                    <span class="inventory-stock-icon"><i class="bi bi-box-seam"></i></span>
                    <div><small>Current stock</small><strong>@Model.StockQuantity.ToString("0.##") @Model.Unit</strong></div>
                    <span class="inventory-stock-help">Use Restock or Adjust stock on the product page to change this balance.</span>
                </div>
            </section>

            <section class="inventory-form-section">
                <div class="inventory-section-heading">
                    <span class="inventory-section-icon"><i class="bi bi-image"></i></span>
                    <div><h3>Product image</h3><p>Upload a replacement or leave empty to keep the current image.</p></div>
                </div>
                <div class="inventory-image-editor">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img src="@imageUrl" alt="@Model.Name" class="inventory-image-preview" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                        <div class="inventory-image-preview inventory-image-empty" hidden><i class="bi bi-image"></i></div>
                    }
                    else
                    {
                        <div class="inventory-image-preview inventory-image-empty"><i class="bi bi-image"></i></div>
                    }
                    <div class="inventory-field">
                        <label for="ImageFile" class="form-label">Replace image <span class="text-muted fw-normal">Optional</span></label>
                        <input id="ImageFile" name="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <small>JPG, PNG, or WEBP. Maximum 3 MB.</small>
                    </div>
                </div>
            </section>
        </div>

        <aside class="inventory-editor-aside">
            <div class="inventory-aside-card inventory-edit-summary">
                <div class="inventory-summary-image">
                    @if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        <img src="@imageUrl" alt="" />
                    }
                    else
                    {
                        <i class="bi bi-scissors"></i>
                    }
                </div>
                <small>Editing product</small>
                <h3>@Model.Name</h3>
                <span>@Model.Sku</span>
                <div class="inventory-summary-stock"><i class="bi bi-box-seam"></i> @Model.StockQuantity.ToString("0.##") @Model.Unit on hand</div>
            </div>
            <div class="inventory-editor-actions">
                <a asp-action="Details" asp-route-id="@Model.FabricId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save changes</button>
            </div>
        </aside>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const unit = document.getElementById('Unit');
            const reorderLevel = document.getElementById('ReorderLevel');
            function syncStep() {
                reorderLevel.step = unit.value === 'roll' || unit.value === 'piece' ? '1' : '0.01';
            }
            unit.addEventListener('change', syncStep);
            syncStep();
        })();
    </script>
}
