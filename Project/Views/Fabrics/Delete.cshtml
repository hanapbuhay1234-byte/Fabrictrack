@model FabriTrack.Models.Fabric
@{
    ViewData["Title"] = "Delete Fabric";
}

<h2 class="mb-3"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Delete fabric</h2>

<div class="confirm-card">
    <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@Model.StockQuantity @Model.Unit</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="FabricId" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i>Delete</button>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-lg me-1"></i>Cancel</a>
</form>
