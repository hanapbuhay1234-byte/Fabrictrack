@model FabriTrack.Models.Fabric
@{
    ViewData["Title"] = "Fabric Details";
}

<h2 class="mb-3"><i class="bi bi-boxes me-2"></i>@Model.Name</h2>

<div class="form-card">
    <div class="row mb-0">
        <div class="col-md-4 mb-3">
            @{
                var src = Html.NormalizeImageUrl(Model.ImageUrl);
            }
            @if (!string.IsNullOrWhiteSpace(src))
            {
                <img src="@src" alt="@Model.Name" class="img-fluid rounded" onerror="this.style.display='none'; document.getElementById('detail-placeholder').classList.remove('d-none');" />
                <div id="detail-placeholder" class="d-none">
                    <div class="d-flex align-items-center justify-content-center bg-light rounded" style="width:100%;height:200px;">
                        <i class="bi bi-image" style="font-size:3rem;color:rgba(0,0,0,0.35);"></i>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center bg-light rounded" style="width:100%;height:200px;">
                    <i class="bi bi-image" style="font-size:3rem;color:rgba(0,0,0,0.35);"></i>
                </div>
            }
        </div>
        <dl class="col-md-8 row mb-0">
            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@Model.Category?.Name</dd>
            <dt class="col-sm-3">Color</dt>
            <dd class="col-sm-9">@Model.Color</dd>
            <dt class="col-sm-3">Pattern</dt>
            <dd class="col-sm-9">@Model.Pattern</dd>
            <dt class="col-sm-3">Price</dt>
            <dd class="col-sm-9">₱@Model.PricePerUnit.ToString("N2") / @Model.Unit</dd>
            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">
                @String.Format("{0:0.##}", Model.StockQuantity) @Model.Unit
                @if (Model.StockQuantity <= 0)
                {
                    <span class="badge badge-low ms-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Out of stock</span>
                }
                else
                {
                    <span class="badge badge-ok ms-1"><i class="bi bi-check-circle-fill me-1"></i>In stock</span>
                }
            </dd>
            <dt class="col-sm-3">Supplier</dt>
            <dd class="col-sm-9">@Model.Supplier?.Name</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back to inventory</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.FabricId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
</div>
