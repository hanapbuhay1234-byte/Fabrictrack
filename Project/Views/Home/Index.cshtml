@{
    ViewData["Title"] = "Dashboard";
    var recentSales = (IEnumerable<Sale>)ViewBag.RecentSales;
}

<div class="page-header">
    <h2><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
    <a asp-controller="Sales" asp-action="Create" class="btn btn-primary"><i class="bi bi-cart-plus me-1"></i>New sale</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-chip primary"><i class="bi bi-boxes"></i></div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.TotalFabrics</div>
                <div class="stat-label">Total fabrics</div>
                <div class="stat-secondary">All active products in inventory</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-chip danger"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.LowStockCount</div>
                <div class="stat-label">Out of stock items</div>
                <div class="stat-secondary"><a href="@Url.Action("LowStock", "Fabrics")">View report</a></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-chip success"><i class="bi bi-graph-up-arrow"></i></div>
            <div class="stat-body">
                <div class="stat-value">₱@ViewBag.TodaySales.ToString("N2")</div>
                <div class="stat-label">Today's sales</div>
                <div class="stat-secondary">Sales completed today</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-chip accent"><i class="bi bi-people"></i></div>
            <div class="stat-body">
                <div class="stat-value">@ViewBag.TotalCustomers</div>
                <div class="stat-label">Customers</div>
                <div class="stat-secondary">Distinct customers in database</div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0"><i class="bi bi-receipt me-2"></i>Recent Sales</h4>
    <a asp-controller="Sales" asp-action="Index" class="btn btn-sm btn-outline-secondary">View all</a>
</div>

@if (recentSales.Any())
{
    <div class="table-container">
        <table class="table table-striped table-hover data-table" data-page-size="5">
            <thead>
                <tr><th data-sort>#</th><th data-sort>Date</th><th data-sort>Customer</th><th data-sort>Total</th></tr>
            </thead>
            <tbody>
                @foreach (var sale in recentSales)
                {
                    <tr>
                        <td>@sale.SaleId</td>
                        <td data-sort-value="@sale.SaleDate.ToString("yyyy-MM-ddTHH:mm")">@sale.SaleDate.ToString("MMM d, yyyy h:mm tt")</td>
                        <td>@(sale.Customer?.FullName ?? "Walk-in")</td>
                        <td>₱@sale.TotalAmount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox display-6 d-block mb-2"></i>
        No sales recorded yet.
    </div>
}
