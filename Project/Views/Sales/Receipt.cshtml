@model FabriTrack.Models.Sale
@{
    ViewData["Title"] = "Receipt #" + Model.SaleId;
    var requestedAutoPrint = ViewBag.AutoPrint as bool? == true;
    var autoPrint = !Model.IsVoided && requestedAutoPrint;
}

<div class="receipt-page">
    <div class="receipt-card">
        <header class="receipt-header">
            <div class="receipt-brand">
                <span class="receipt-brand-mark"><i class="bi bi-scissors" aria-hidden="true"></i></span>
                <div>
                    <h1>FabriTrack</h1>
                    <div class="text-muted">Fabric inventory &amp; sales</div>
                </div>
            </div>
            <div class="receipt-number">
                <span>Sales receipt</span>
                <strong>#@Model.SaleId</strong>
            </div>
        </header>

        @if (Model.IsVoided)
        {
            <div class="receipt-void-banner">
                <strong>VOIDED — NOT A VALID SALES RECEIPT</strong>
                <span>Voided @Model.VoidedAt?.ToString("MMM d, yyyy h:mm tt")</span>
                <span>Reason: @Model.VoidReason</span>
            </div>
        }

        <div class="receipt-meta">
            <div>
                <span class="receipt-meta-label">Date and time</span>
                <strong data-sort-value="@Model.SaleDate.ToString("yyyy-MM-ddTHH:mm")">@Model.SaleDate.ToString("MMM d, yyyy h:mm tt")</strong>
            </div>
            <div>
                <span class="receipt-meta-label">Customer</span>
                <strong>@(Model.Customer?.FullName ?? "Walk-in customer")</strong>
            </div>
            <div>
                <span class="receipt-meta-label">Processed by</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.CashierName) ? "Unknown" : Model.CashierName)</strong>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table receipt-items">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit price</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.SaleItems)
                    {
                        <tr>
                            <td>
                                <strong>@item.ProductName</strong>
                                <div class="small text-muted">@item.ProductSku@(string.IsNullOrWhiteSpace(item.Color) ? "" : $" · {item.Color}")</div>
                            </td>
                            <td class="text-end text-nowrap">@String.Format("{0:0.##}", item.Quantity) @item.Unit</td>
                            <td class="text-end text-nowrap">₱@item.UnitPrice.ToString("N2")</td>
                            <td class="text-end text-nowrap">₱@item.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="receipt-total">
            <span>Total</span>
            <strong>₱@Model.TotalAmount.ToString("N2")</strong>
        </div>

        @if (!Model.IsVoided)
        {
            <div class="receipt-thank-you">Thank you for your purchase.</div>
        }
    </div>

    <div id="receiptPrintStatus" class="receipt-print-status" role="status" aria-live="polite" hidden>
        <span class="receipt-printer-animation" aria-hidden="true"><i class="bi bi-printer"></i></span>
        <span id="receiptPrintMessage">Preparing the receipt for printing...</span>
    </div>

    <div class="receipt-page-actions">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Sales history</a>
        <a asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-cart-plus me-1"></i>New sale</a>
        @if (!Model.IsVoided)
        {
            <button id="printReceiptButton" type="button" class="btn btn-primary"><i class="bi bi-printer me-1"></i>Print receipt</button>
        }
    </div>
    <p class="receipt-print-note">Your browser will open its print dialog. Select a printer or choose Save as PDF.</p>
</div>

@section Scripts {
    <script>
        (() => {
            const status = document.getElementById('receiptPrintStatus');
            const message = document.getElementById('receiptPrintMessage');
            let printQueued = false;

            function preparePrint() {
                if (printQueued) return;
                printQueued = true;
                status.hidden = false;
                status.classList.remove('is-done');
                status.classList.add('is-printing');
                message.textContent = 'Preparing the receipt for printing...';
                window.setTimeout(() => window.print(), 1100);
            }

            const printButton = document.getElementById('printReceiptButton');
            if (printButton) printButton.addEventListener('click', preparePrint);
            window.addEventListener('afterprint', () => {
                if (!printQueued) return;
                status.classList.remove('is-printing');
                status.classList.add('is-done');
                message.textContent = 'Print dialog closed. If you did not print the receipt, select Print receipt to try again.';
                printQueued = false;
            });

            if (@(autoPrint ? "true" : "false")) {
                preparePrint();
            }
        })();
    </script>
}
