@model FabriTrack.Models.Sale
@{
    ViewData["Title"] = "Receipt #" + Model.SaleId;
}

<div class="receipt-card">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <div class="brand-name">FabriTrack</div>
            <div class="text-muted">Fabric inventory & sales</div>
        </div>
        <div class="text-end">
            <div><strong>Receipt</strong></div>
            <div class="small text-muted">#@Model.SaleId</div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div><strong>Date</strong></div>
            @* Date formatting placeholder: configured elsewhere; keep short datetime for local display *@
            <div class="small text-muted" data-sort-value="@Model.SaleDate.ToString("yyyy-MM-ddTHH:mm")">@Model.SaleDate.ToString("MMM d, yyyy h:mm tt")</div>
        </div>
        <div class="col-md-6 text-md-end">
            <div><strong>Customer</strong></div>
            <div class="small text-muted">@(Model.Customer?.FullName ?? "Walk-in")</div>
            <div class="small text-muted">@Model.SaleDate.ToString("g")</div>
            @* CashierId is a raw identifier; do not display here. *@
        </div>
    </div>

    <table class="table">
        <thead><tr><th>Product / SKU</th><th>Qty</th><th>Unit price</th><th>Subtotal</th></tr></thead>
        <tbody>
            @foreach (var item in Model.SaleItems)
            {
                <tr>
                    <td><strong>@item.ProductName</strong><div class="small text-muted">@item.ProductSku@(string.IsNullOrWhiteSpace(item.Color) ? "" : $" · {item.Color}")</div></td>
                    <td>@String.Format("{0:0.##}", item.Quantity)</td>
                    <td>₱@item.UnitPrice.ToString("N2")</td>
                    <td>₱@item.Subtotal.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="receipt-total"><th colspan="3" class="text-end">Total</th><th>₱@Model.TotalAmount.ToString("N2")</th></tr>
        </tfoot>
    </table>
    <!-- Keep receipt markup for print CSS -->
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back to sales history</a>
    <button onclick="window.print()" class="btn btn-outline-primary"><i class="bi bi-printer me-1"></i>Print receipt</button>
</div>
