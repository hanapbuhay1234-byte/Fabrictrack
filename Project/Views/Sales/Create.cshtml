@{
    ViewData["Title"] = "New Sale";
    var fabrics = (IEnumerable<FabriTrack.Models.Fabric>)ViewBag.Fabrics;
}

<h2 class="mb-3"><i class="bi bi-cart-plus me-2"></i>New sale</h2>

@if (!fabrics.Any())
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>No fabrics are currently in stock. Add inventory before recording a sale.</div>
}

<form asp-action="Create" method="post" id="saleForm">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-lg-8">
            <div class="form-card mb-3">
                <label class="form-label"><i class="bi bi-person me-1"></i>Customer (optional)</label>
                <select name="customerId" class="form-select" asp-items="ViewBag.Customers">
                    <option value="">Walk-in customer</option>
                </select>
            </div>

            <div class="table-container mb-3">
                <table class="table pos-table" id="lineItemsTable">
                    <thead>
                        <tr><th>Fabric</th><th>Available stock</th><th>Price</th><th>Quantity</th><th></th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <select name="fabricIds" class="form-select fabric-select" onchange="updateRow(this)">
                                    <option value="">-- Select fabric --</option>
                                    @foreach (var f in fabrics)
                                    {
                                        <option value="@f.FabricId" data-price="@f.PricePerUnit" data-stock="@f.StockQuantity" data-unit="@f.Unit">
                                            @f.Name (@f.Color) — ₱@f.PricePerUnit.ToString("N2")/@f.Unit
                                        </option>
                                    }
                                </select>
                            </td>
                            <td class="stock-cell text-muted">—</td>
                            <td class="price-cell text-muted">—</td>
                            <td><input type="number" name="quantities" class="form-control" step="1" min="1" value="1" onchange="updateTotal()" oninput="updateTotal()" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeRow(this)"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <button type="button" class="btn btn-outline-secondary mb-3" onclick="addRow()"><i class="bi bi-plus-lg me-1"></i>Add line</button>
        </div>

        <div class="col-lg-4">
            <div class="form-card sticky-summary mb-3">
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">Estimated total</span>
                    <span class="fw-bold" id="estimatedTotal" style="color: var(--ft-primary);">₱0.00</span>
                </div>
                <div class="small text-muted mt-1">Final total is calculated on the server at checkout.</div>
                <div class="mt-3 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg" @(!fabrics.Any() ? "disabled" : "")><i class="bi bi-check-circle me-1"></i>Complete sale</button>
                    <a asp-action="Index" class="btn btn-secondary mt-2"><i class="bi bi-x-lg me-1"></i>Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updateRow(select) {
            var row = select.closest('tr');
            var opt = select.options[select.selectedIndex];
            row.querySelector('.price-cell').textContent = opt.dataset.price ? '₱' + parseFloat(opt.dataset.price).toFixed(2) : '—';
            row.querySelector('.stock-cell').textContent = opt.dataset.stock ? parseFloat(opt.dataset.stock).toFixed(0) + ' ' + opt.dataset.unit : '—';
            updateTotal();
        }
        function addRow() {
            var table = document.getElementById('lineItemsTable').getElementsByTagName('tbody')[0];
            var newRow = table.rows[0].cloneNode(true);
            newRow.querySelectorAll('select, input').forEach(el => {
                if (el.tagName === 'SELECT') {
                    el.selectedIndex = 0;
                    el.onchange = function() { updateRow(this); };
                }
                if (el.tagName === 'INPUT') {
                    el.value = 1;
                    el.onchange = function() { updateTotal(); };
                    el.oninput = function() { updateTotal(); };
                }
            });
            var removeBtn = newRow.querySelector('.btn-outline-danger');
            if (removeBtn) {
                removeBtn.onclick = function() { removeRow(this); };
            }
            newRow.querySelector('.price-cell').textContent = '—';
            newRow.querySelector('.stock-cell').textContent = '—';
            table.appendChild(newRow);
            updateTotal();
        }
        function removeRow(btn) {
            var table = document.getElementById('lineItemsTable').getElementsByTagName('tbody')[0];
            if (table.rows.length > 1) btn.closest('tr').remove();
            updateTotal();
        }
        function updateTotal() {
            var rows = document.getElementById('lineItemsTable').getElementsByTagName('tbody')[0].rows;
            var total = 0;
            for (var i = 0; i < rows.length; i++) {
                var select = rows[i].querySelector('.fabric-select');
                var opt = select.options[select.selectedIndex];
                var qtyInput = rows[i].querySelector('input[name="quantities"]');
                var price = opt && opt.dataset.price ? parseFloat(opt.dataset.price) : 0;
                var qty = qtyInput && qtyInput.value ? parseInt(qtyInput.value, 10) : 0;
                if (!isNaN(price) && !isNaN(qty)) total += price * qty;
            }
            document.getElementById('estimatedTotal').textContent = '₱' + total.toFixed(2);
        }
        document.addEventListener('DOMContentLoaded', updateTotal);
    </script>
}
