@{
    ViewData["Title"] = "New Sale";
    var fabrics = (IEnumerable<Fabric>)ViewBag.Fabrics;
    var initialCart = ViewBag.InitialCart as string ?? "[]";
}

<div class="page-header">
    <div>
        <h2><i class="bi bi-cart-plus me-2"></i>New sale</h2>
        <div class="text-muted small">Choose products, add them to the cart, and review the order before checkout.</div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-clock-history me-1"></i>Sales history</a>
</div>

<form asp-action="Create" method="post" id="saleForm">
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <div class="row g-4 align-items-start">
        <div class="col-md-7 col-xl-8">
            <div class="pos-toolbar mb-3">
                <div class="input-group pos-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input id="productSearch" type="search" class="form-control" placeholder="Search by product, SKU, color, or pattern..." aria-label="Search products" autocomplete="off" />
                </div>
                <select id="categoryFilter" class="form-select" aria-label="Filter by category" asp-items="ViewBag.Categories">
                    <option value="">All categories</option>
                </select>
            </div>

            @if (!fabrics.Any())
            {
                <div class="pos-empty-state">
                    <i class="bi bi-box-seam"></i>
                    <h3>No products found</h3>
                    <p>There are no active products in inventory yet. Add products before recording a sale.</p>
                </div>
            }
            else
            {
                <div id="productGrid" class="pos-product-grid">
                    @foreach (var fabric in fabrics)
                    {
                        var imageUrl = Html.NormalizeImageUrl(fabric.ImageUrl);
                        var categoryName = fabric.Category?.Name ?? "Uncategorized";
                        var isOutOfStock = fabric.StockQuantity <= 0 ||
                            (FabriTrack.Models.ProductUnits.IsDiscrete(fabric.Unit) && fabric.StockQuantity < 1);
                        var isLowStock = !isOutOfStock && fabric.StockQuantity <= fabric.ReorderLevel;
                        <article class="pos-product-card"
                                 data-name="@fabric.Name"
                                 data-sku="@fabric.Sku"
                                 data-color="@fabric.Color"
                                 data-pattern="@fabric.Pattern"
                                 data-category="@categoryName"
                                 data-category-id="@fabric.CategoryId">
                            <div class="pos-product-image">
                                @if (!string.IsNullOrWhiteSpace(imageUrl))
                                {
                                    <img src="@imageUrl" alt="@fabric.Name" loading="lazy"
                                         onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                                    <div class="pos-image-fallback" hidden aria-hidden="true"><i class="bi bi-scissors"></i></div>
                                }
                                else
                                {
                                    <div class="pos-image-fallback" aria-hidden="true"><i class="bi bi-scissors"></i></div>
                                }
                                @if (isOutOfStock)
                                {
                                    <span class="pos-stock-badge pos-stock-out">Out of stock</span>
                                }
                                else if (isLowStock)
                                {
                                    <span class="pos-stock-badge pos-stock-low">Low stock</span>
                                }
                            </div>
                            <div class="pos-product-content">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div class="min-w-0">
                                        <h3 class="pos-product-name">@fabric.Name</h3>
                                        <div class="pos-product-meta">
                                            @if (!string.IsNullOrWhiteSpace(fabric.Color))
                                            {
                                                <span>@fabric.Color</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(fabric.Pattern))
                                            {
                                                <span>@fabric.Pattern</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="pos-category-chip">@categoryName</span>
                                </div>
                                <div class="pos-product-details">
                                    <div>
                                        <div class="pos-product-price">₱@fabric.PricePerUnit.ToString("N2")</div>
                                        <div class="small text-muted">per @fabric.Unit</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="pos-stock-quantity">@fabric.StockQuantity.ToString("0.##") @fabric.Unit</div>
                                        <div class="small text-muted">available</div>
                                    </div>
                                </div>
                                <button type="button"
                                        class="btn btn-primary w-100 pos-add-button"
                                        data-fabric-id="@fabric.FabricId"
                                        data-name="@fabric.Name"
                                        data-sku="@fabric.Sku"
                                        data-color="@fabric.Color"
                                        data-category="@categoryName"
                                        data-price="@fabric.PricePerUnit.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-stock="@fabric.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                        data-unit="@fabric.Unit"
                                        disabled="@isOutOfStock">
                                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                                    <span class="pos-add-button-label">Add to order</span>
                                    <span class="pos-add-quantity" hidden></span>
                                </button>
                            </div>
                        </article>
                    }
                </div>
                <div id="noProductsMessage" class="pos-empty-state mt-3" hidden>
                    <i class="bi bi-search"></i>
                    <h3>No matching products</h3>
                    <p>Try a different search or category.</p>
                </div>
            }
        </div>

        <div class="col-md-5 col-xl-4 pos-cart-column">
            <section class="pos-cart-card" aria-labelledby="orderHeading">
                <div class="pos-cart-header">
                    <div>
                        <h3 id="orderHeading"><i class="bi bi-basket2 me-2"></i>Current order</h3>
                        <div id="cartItemCount" class="small text-muted">0 items</div>
                    </div>
                    <button id="clearCartButton" type="button" class="btn btn-sm btn-outline-secondary" disabled>Clear</button>
                </div>

                <div class="pos-customer-field">
                    <label for="customerId" class="form-label">Customer <span class="text-muted fw-normal">(optional)</span></label>
                    <div class="input-group">
                        <select id="customerId" name="customerId" class="form-select" asp-items="ViewBag.Customers">
                            <option value="">Walk-in customer</option>
                        </select>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#quickCustomerModal">
                            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>New
                        </button>
                    </div>
                </div>

                <div id="cartLines" class="pos-cart-lines" aria-live="polite"></div>
                <div id="emptyCartMessage" class="pos-cart-empty">
                    <i class="bi bi-basket"></i>
                    <div class="fw-semibold mt-2">Your order is empty</div>
                    <div class="small text-muted">Add a product from the catalog to get started.</div>
                </div>

                <div class="pos-cart-summary">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Estimated total</span>
                        <strong id="estimatedTotal">₱0.00</strong>
                    </div>
                    <div class="small text-muted mt-1">Final prices and stock are verified at checkout.</div>
                    <button id="completeSaleButton" type="button" class="btn btn-primary btn-lg w-100 mt-3" disabled>
                        <i class="bi bi-check-circle me-1"></i>Complete sale
                    </button>
                    <a asp-action="Index" class="btn btn-link w-100 mt-1 text-decoration-none">Cancel</a>
                </div>
            </section>
        </div>
    </div>
</form>

<div class="modal fade" id="quickCustomerModal" tabindex="-1" aria-labelledby="quickCustomerTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="quickCustomerForm" asp-action="CreateCustomer" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title fs-5" id="quickCustomerTitle"><i class="bi bi-person-plus me-2"></i>Add customer</h2>
                        <p class="small text-muted mb-0">Add a customer without leaving the current order.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="quickCustomerError" class="alert alert-danger" role="alert" hidden></div>
                    <div class="mb-3">
                        <label for="quickCustomerName" class="form-label">Full name <span class="text-danger">*</span></label>
                        <input id="quickCustomerName" name="FullName" class="form-control" maxlength="150" autocomplete="name" required />
                    </div>
                    <div class="mb-3">
                        <label for="quickCustomerPhone" class="form-label">Phone number <span class="text-muted">(optional)</span></label>
                        <input id="quickCustomerPhone" name="ContactNumber" class="form-control" maxlength="20" type="tel" autocomplete="tel" />
                    </div>
                    <div>
                        <label for="quickCustomerEmail" class="form-label">Email <span class="text-muted">(optional)</span></label>
                        <input id="quickCustomerEmail" name="Email" class="form-control" maxlength="150" type="email" autocomplete="email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="quickCustomerSave" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save and select
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="saleReviewModal" tabindex="-1" aria-labelledby="saleReviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content sale-review-modal">
            <div class="modal-header">
                <div>
                    <div class="small text-uppercase text-muted fw-semibold">Final order review</div>
                    <h2 class="modal-title fs-5" id="saleReviewTitle">Review before recording</h2>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="sale-review-customer mb-3">
                    <span class="text-muted">Customer</span>
                    <strong id="reviewCustomer">Walk-in customer</strong>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle sale-review-table mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit price</th>
                                <th class="text-end">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody id="reviewLines"></tbody>
                    </table>
                </div>
                <div class="sale-review-total">
                    <span>Total</span>
                    <strong id="reviewTotal">₱0.00</strong>
                </div>
                <div class="small text-muted mt-3">
                    This is an order review, not a receipt. Inventory and current prices will be checked again before the sale is recorded.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back to order</button>
                <button type="button" id="confirmSaleButton" class="btn btn-primary">
                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>Confirm and record sale
                </button>
            </div>
        </div>
    </div>
</div>

<div id="initialCartData" data-cart="@initialCart" hidden></div>

@section Scripts {
    <script>
        (() => {
            const cart = new Map();
            const cartLines = document.getElementById('cartLines');
            const emptyCartMessage = document.getElementById('emptyCartMessage');
            const countElement = document.getElementById('cartItemCount');
            const totalElement = document.getElementById('estimatedTotal');
            const completeButton = document.getElementById('completeSaleButton');
            const clearButton = document.getElementById('clearCartButton');
            const saleForm = document.getElementById('saleForm');
            const reviewModalElement = document.getElementById('saleReviewModal');
            const reviewModal = new bootstrap.Modal(reviewModalElement);
            const reviewLines = document.getElementById('reviewLines');
            const reviewCustomer = document.getElementById('reviewCustomer');
            const reviewTotal = document.getElementById('reviewTotal');
            const confirmSaleButton = document.getElementById('confirmSaleButton');
            const quickCustomerForm = document.getElementById('quickCustomerForm');
            const quickCustomerModalElement = document.getElementById('quickCustomerModal');
            const quickCustomerModal = new bootstrap.Modal(quickCustomerModalElement);
            const quickCustomerError = document.getElementById('quickCustomerError');
            const quickCustomerSave = document.getElementById('quickCustomerSave');
            const customerSelect = document.getElementById('customerId');
            const currency = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' });
            const quantityFormatter = new Intl.NumberFormat('en-PH', { maximumFractionDigits: 2 });
            let checkoutConfirmed = false;

            function formatQuantity(value) {
                return quantityFormatter.format(value);
            }

            function quantityStep(item) {
                return item.unit === 'roll' || item.unit === 'piece' ? 1 : 0.5;
            }

            function createElement(tag, className, text) {
                const element = document.createElement(tag);
                if (className) element.className = className;
                if (text !== undefined) element.textContent = text;
                return element;
            }

            function removeItem(id) {
                cart.delete(id);
                renderCart();
            }

            function updateQuantity(id, value) {
                const item = cart.get(id);
                if (!item) return;
                const minimum = quantityStep(item);
                const parsed = Number(value);
                const safeValue = Number.isFinite(parsed) ? parsed : minimum;
                const quantity = Math.min(item.stock, Math.max(minimum, safeValue));
                item.quantity = minimum === 1 ? Math.round(quantity) : Math.round(quantity * 100) / 100;
                renderCart();
            }

            function renderCart() {
                cartLines.replaceChildren();
                let total = 0;

                for (const item of cart.values()) {
                    total += item.price * item.quantity;

                    const line = createElement('article', 'pos-cart-line');
                    const details = createElement('div', 'pos-cart-line-main');
                    const titleRow = createElement('div', 'd-flex justify-content-between gap-2');
                    const info = createElement('div', 'min-w-0');
                    info.append(
                        createElement('div', 'pos-cart-item-name', item.name),
                        createElement('div', 'small text-muted', `${item.sku}${item.color ? ` · ${item.color}` : ''}`),
                        createElement('div', 'small text-muted', `${currency.format(item.price)} / ${item.unit}`)
                    );
                    const subtotal = createElement('strong', 'pos-cart-subtotal', currency.format(item.price * item.quantity));
                    titleRow.append(info, subtotal);

                    const controls = createElement('div', 'pos-cart-controls');
                    const quantityGroup = createElement('div', 'pos-quantity-control');
                    const decrease = createElement('button', 'btn btn-sm btn-outline-secondary', '−');
                    decrease.type = 'button';
                    decrease.setAttribute('aria-label', `Decrease ${item.name} quantity`);
                    decrease.addEventListener('click', () => {
                        const step = quantityStep(item);
                        if (item.quantity <= step) removeItem(item.id);
                        else updateQuantity(item.id, item.quantity - step);
                    });
                    const quantityInput = document.createElement('input');
                    quantityInput.type = 'number';
                    quantityInput.className = 'form-control form-control-sm';
                    quantityInput.name = 'quantities';
                    quantityInput.min = String(quantityStep(item));
                    quantityInput.max = String(item.stock);
                    quantityInput.step = item.unit === 'roll' || item.unit === 'piece' ? '1' : '0.01';
                    quantityInput.value = String(item.quantity);
                    quantityInput.setAttribute('aria-label', `${item.name} quantity in ${item.unit}`);
                    quantityInput.addEventListener('change', () => updateQuantity(item.id, quantityInput.value));
                    const increase = createElement('button', 'btn btn-sm btn-outline-secondary', '+');
                    increase.type = 'button';
                    increase.disabled = item.quantity >= item.stock;
                    increase.setAttribute('aria-label', `Increase ${item.name} quantity`);
                    increase.addEventListener('click', () => updateQuantity(item.id, Math.min(item.stock, item.quantity + quantityStep(item))));
                    quantityGroup.append(decrease, quantityInput, increase);

                    const stock = createElement('span', 'small text-muted', `${formatQuantity(item.stock)} ${item.unit} available`);
                    const remove = createElement('button', 'btn btn-sm btn-link text-danger p-0', 'Remove');
                    remove.type = 'button';
                    remove.addEventListener('click', () => removeItem(item.id));
                    controls.append(quantityGroup, stock, remove);

                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'fabricIds';
                    idInput.value = String(item.id);
                    line.append(titleRow, controls, idInput);
                    cartLines.append(line);
                }

                countElement.textContent = `${cart.size} ${cart.size === 1 ? 'product' : 'products'} in order`;
                totalElement.textContent = currency.format(total);
                emptyCartMessage.hidden = cart.size > 0;
                completeButton.disabled = cart.size === 0;
                clearButton.disabled = cart.size === 0;

                document.querySelectorAll('.pos-add-button').forEach(button => {
                    const item = cart.get(Number(button.dataset.fabricId));
                    const label = button.querySelector('.pos-add-button-label');
                    const quantityBadge = button.querySelector('.pos-add-quantity');
                    if (!item) {
                        button.classList.remove('in-cart');
                        button.disabled = Number(button.dataset.stock) <= 0 ||
                            ((button.dataset.unit === 'roll' || button.dataset.unit === 'piece') && Number(button.dataset.stock) < 1);
                        label.textContent = 'Add to order';
                        quantityBadge.hidden = true;
                        button.removeAttribute('aria-label');
                        return;
                    }

                    button.classList.add('in-cart');
                    label.textContent = item.quantity >= item.stock ? 'Stock limit reached' : 'Add another';
                    quantityBadge.textContent = `${formatQuantity(item.quantity)} ${item.unit} in order`;
                    quantityBadge.hidden = false;
                    button.disabled = item.quantity >= item.stock;
                    button.setAttribute('aria-label', `${item.name}, ${formatQuantity(item.quantity)} ${item.unit} in order${item.quantity >= item.stock ? '' : ', add another'}`);
                });
            }

            function renderOrderReview() {
                reviewLines.replaceChildren();
                let total = 0;
                for (const item of cart.values()) {
                    const subtotal = item.price * item.quantity;
                    total += subtotal;
                    const row = document.createElement('tr');
                    const productCell = document.createElement('td');
                    productCell.append(
                        createElement('div', 'fw-semibold', item.name),
                        createElement('div', 'small text-muted', `${item.sku}${item.color ? ` · ${item.color}` : ''}`)
                    );
                    const quantityCell = createElement('td', 'text-end text-nowrap', `${formatQuantity(item.quantity)} ${item.unit}`);
                    const priceCell = createElement('td', 'text-end text-nowrap', currency.format(item.price));
                    const subtotalCell = createElement('td', 'text-end text-nowrap fw-semibold', currency.format(subtotal));
                    row.append(productCell, quantityCell, priceCell, subtotalCell);
                    reviewLines.append(row);
                }

                const selectedCustomer = document.getElementById('customerId');
                reviewCustomer.textContent = selectedCustomer.selectedOptions[0]?.textContent.trim() || 'Walk-in customer';
                reviewTotal.textContent = currency.format(total);
            }

            document.querySelectorAll('.pos-add-button').forEach(button => {
                button.addEventListener('click', () => {
                    const id = Number(button.dataset.fabricId);
                    const existing = cart.get(id);
                    if (existing) {
                        const step = quantityStep(existing);
                        existing.quantity = Math.min(existing.stock, Math.round((existing.quantity + step) * 100) / 100);
                    } else {
                        const stock = Number(button.dataset.stock);
                        const unit = button.dataset.unit;
                        const step = unit === 'roll' || unit === 'piece' ? 1 : 0.5;
                        cart.set(id, {
                            id,
                            name: button.dataset.name,
                            sku: button.dataset.sku,
                            color: button.dataset.color,
                            price: Number(button.dataset.price),
                            stock,
                            unit,
                            quantity: Math.min(stock, step)
                        });
                    }
                    renderCart();
                });
            });

            clearButton.addEventListener('click', () => {
                cart.clear();
                renderCart();
            });

            const searchInput = document.getElementById('productSearch');
            const categoryFilter = document.getElementById('categoryFilter');
            const noProductsMessage = document.getElementById('noProductsMessage');
            function filterProducts() {
                const search = searchInput.value.trim().toLocaleLowerCase();
                const categoryId = categoryFilter.value;
                let visibleCount = 0;

                document.querySelectorAll('.pos-product-card').forEach(card => {
                    const searchableText = `${card.dataset.name} ${card.dataset.sku} ${card.dataset.color} ${card.dataset.pattern} ${card.dataset.category}`.toLocaleLowerCase();
                    const visible = searchableText.includes(search) && (!categoryId || card.dataset.categoryId === categoryId);
                    card.hidden = !visible;
                    if (visible) visibleCount++;
                });

                if (noProductsMessage) noProductsMessage.hidden = visibleCount > 0;
            }
            searchInput.addEventListener('input', filterProducts);
            categoryFilter.addEventListener('change', filterProducts);

            completeButton.addEventListener('click', () => {
                if (cart.size === 0 || saleForm.dataset.submitting === 'true') return;
                renderOrderReview();
                reviewModal.show();
            });

            saleForm.addEventListener('submit', event => {
                if (!checkoutConfirmed || saleForm.dataset.submitting === 'true') {
                    event.preventDefault();
                    if (!checkoutConfirmed) {
                        renderOrderReview();
                        reviewModal.show();
                    }
                    return;
                }

                saleForm.dataset.submitting = 'true';
                completeButton.disabled = true;
                completeButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Recording sale...';
                confirmSaleButton.disabled = true;
                confirmSaleButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Recording sale...';
            });

            confirmSaleButton.addEventListener('click', () => {
                if (cart.size === 0 || saleForm.dataset.submitting === 'true') return;
                if (!saleForm.reportValidity()) return;
                checkoutConfirmed = true;
                saleForm.requestSubmit();
                if (saleForm.dataset.submitting === 'true') reviewModal.hide();
            });

            quickCustomerForm.addEventListener('submit', async event => {
                event.preventDefault();
                if (!quickCustomerForm.reportValidity()) return;

                quickCustomerSave.disabled = true;
                quickCustomerSave.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving...';
                quickCustomerError.hidden = true;
                quickCustomerError.textContent = '';

                try {
                    const response = await fetch(quickCustomerForm.action, {
                        method: 'POST',
                        body: new FormData(quickCustomerForm),
                        headers: { 'Accept': 'application/json' }
                    });
                    const result = await response.json();
                    if (!response.ok) {
                        const errors = Array.isArray(result.errors) ? result.errors : ['Could not save the customer. Please check the details and try again.'];
                        quickCustomerError.textContent = errors.join(' ');
                        quickCustomerError.hidden = false;
                        return;
                    }

                    customerSelect.add(new Option(result.fullName, result.customerId, true, true));
                    quickCustomerForm.reset();
                    quickCustomerModal.hide();
                } catch (error) {
                    console.error('Could not create the customer from the sale form.', error);
                    quickCustomerError.textContent = 'The customer could not be saved due to a connection error. Please try again.';
                    quickCustomerError.hidden = false;
                } finally {
                    quickCustomerSave.disabled = false;
                    quickCustomerSave.innerHTML = '<i class="bi bi-check-lg me-1" aria-hidden="true"></i>Save and select';
                }
            });

            quickCustomerModalElement.addEventListener('show.bs.modal', () => {
                quickCustomerError.hidden = true;
                quickCustomerError.textContent = '';
                document.getElementById('quickCustomerName').focus();
            });

            reviewModalElement.addEventListener('hidden.bs.modal', () => {
                if (saleForm.dataset.submitting === 'true') return;
                checkoutConfirmed = false;
                completeButton.disabled = cart.size === 0;
                completeButton.innerHTML = '<i class="bi bi-check-circle me-1"></i>Complete sale';
                confirmSaleButton.disabled = false;
                confirmSaleButton.innerHTML = '<i class="bi bi-check-circle me-1" aria-hidden="true"></i>Confirm and record sale';
            });

            try {
                const initialCart = JSON.parse(document.getElementById('initialCartData').dataset.cart);
                for (const item of initialCart) {
                    const button = document.querySelector(`.pos-add-button[data-fabric-id="${item.fabricId}"]`);
                    if (!button || Number(button.dataset.stock) <= 0) continue;
                    const id = Number(item.fabricId);
                    const stock = Number(button.dataset.stock);
                    const existing = cart.get(id);
                    const quantity = Number(item.quantity);
                    if (!Number.isFinite(quantity) || quantity <= 0) continue;
                    const unit = button.dataset.unit;
                    const step = unit === 'roll' || unit === 'piece' ? 1 : 0.5;
                    if (existing) existing.quantity = Math.min(stock, existing.quantity + quantity);
                    else {
                        cart.set(id, {
                            id,
                            name: button.dataset.name,
                            sku: button.dataset.sku,
                            color: button.dataset.color,
                            price: Number(button.dataset.price),
                            stock,
                            unit,
                            quantity: Math.min(stock, step === 1 ? Math.round(quantity) : quantity)
                        });
                    }
                }
            } catch (error) {
                console.error('Could not restore the submitted order.', error);
            }

            renderCart();
            filterProducts();
        })();
    </script>
}
