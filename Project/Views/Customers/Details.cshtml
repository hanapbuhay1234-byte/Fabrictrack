@model FabriTrack.Models.CustomerDetailsViewModel
@{
    ViewData["Title"] = "Customer Details";
}

<div class="page-header customer-details-header">
    <div>
        <a asp-action="Index" class="customer-back-link"><i class="bi bi-arrow-left me-1"></i>Customers</a>
        <h2><i class="bi bi-person-circle me-2"></i>@Model.FullName</h2>
        <p class="text-muted mb-0">Customer profile and completed purchase history.</p>
    </div>
    @if (User.IsInRole(FabriTrack.Models.Roles.Admin))
    {
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-people me-1"></i>All customers</a>
    }
</div>

<section class="customer-profile-card">
    <div class="customer-profile-contact">
        <div class="customer-profile-field">
            <span><i class="bi bi-telephone me-2"></i>Contact number</span>
            @if (!string.IsNullOrWhiteSpace(Model.ContactNumber))
            {
                <a href="tel:@Model.ContactNumber">@Model.ContactNumber</a>
            }
            else
            {
                <strong class="text-muted">Not provided</strong>
            }
        </div>
        <div class="customer-profile-field">
            <span><i class="bi bi-envelope me-2"></i>Email</span>
            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <a href="mailto:@Model.Email">@Model.Email</a>
            }
            else
            {
                <strong class="text-muted">Not provided</strong>
            }
        </div>
        <div class="customer-profile-field">
            <span><i class="bi bi-geo-alt me-2"></i>Address</span>
            <strong>@(string.IsNullOrWhiteSpace(Model.Address) ? "Not provided" : Model.Address)</strong>
        </div>
    </div>
    <div class="customer-profile-metrics">
        <article class="customer-profile-metric">
            <span>Completed purchases</span>
            <strong>@Model.CompletedPurchaseCount</strong>
        </article>
        <article class="customer-profile-metric">
            <span>Lifetime spend</span>
            <strong>₱@Model.LifetimeSpend.ToString("N2")</strong>
        </article>
    </div>
</section>

<section class="customer-purchase-panel">
    <div class="customer-purchase-heading">
        <div>
            <h3><i class="bi bi-receipt me-2"></i>Purchase history</h3>
            <p class="text-muted mb-0">Completed sales only; voided transactions are excluded.</p>
        </div>
        @if (Model.TotalPurchases > 0)
        {
            <span class="customer-purchase-count">@Model.TotalPurchases purchase(s)</span>
        }
    </div>

    @if (Model.Purchases.Count == 0)
    {
        <div class="customer-empty-state compact">
            <i class="bi bi-basket"></i>
            <h3>No completed purchases yet</h3>
            <p>This customer’s completed sales will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-container customer-purchase-table-container">
            <table class="table customer-purchase-table">
                <thead>
                    <tr><th>Sale</th><th>Date</th><th class="text-end">Total</th><th class="text-end">Receipt</th></tr>
                </thead>
                <tbody>
                    @foreach (var purchase in Model.Purchases)
                    {
                        <tr>
                            <td class="fw-semibold">#@purchase.SaleId</td>
                            <td class="text-nowrap" data-sort-value="@purchase.SaleDate.ToString("yyyy-MM-ddTHH:mm")">@purchase.SaleDate.ToString("MMM d, yyyy h:mm tt")</td>
                            <td class="text-end text-nowrap fw-semibold">₱@purchase.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@purchase.SaleId"
                                   class="btn btn-sm btn-outline-primary" aria-label="View receipt for sale @purchase.SaleId">
                                    <i class="bi bi-receipt me-1"></i>View receipt
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="customer-pagination" aria-label="Purchase history pages">
                <span class="text-muted small">Page @Model.Page of @Model.TotalPages</span>
                <div class="btn-group btn-group-sm">
                    @if (Model.HasPreviousPage)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-page="@(Model.Page - 1)">
                            <i class="bi bi-chevron-left"></i><span class="visually-hidden">Previous</span>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary disabled" aria-disabled="true"><i class="bi bi-chevron-left"></i><span class="visually-hidden">Previous</span></span>
                    }
                    @if (Model.HasNextPage)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.CustomerId" asp-route-page="@(Model.Page + 1)">
                            <i class="bi bi-chevron-right"></i><span class="visually-hidden">Next</span>
                        </a>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary disabled" aria-disabled="true"><i class="bi bi-chevron-right"></i><span class="visually-hidden">Next</span></span>
                    }
                </div>
            </nav>
        }
    }
</section>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to customers</a>
</div>
