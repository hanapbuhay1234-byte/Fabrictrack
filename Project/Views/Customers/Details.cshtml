@model FabriTrack.Models.Customer
@{
    ViewData["Title"] = "Customer Details";
}

<h2 class="mb-3"><i class="bi bi-person me-2"></i>@Model.FullName</h2>

<div class="form-card mb-4">
    <dl class="row mb-0">
        <dt class="col-sm-3">Contact</dt>
        <dd class="col-sm-9">@Model.ContactNumber</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Address</dt>
        <dd class="col-sm-9">@Model.Address</dd>
    </dl>
</div>

<h4><i class="bi bi-receipt me-2"></i>Purchase history</h4>
@if (!Model.Sales.Any())
{
    <p class="text-muted">No purchases yet.</p>
}
else
{
    <table class="table data-table" data-page-size="10">
        <thead><tr><th data-sort>#</th><th data-sort>Date</th><th data-sort>Total</th></tr></thead>
        <tbody>
            @foreach (var s in Model.Sales)
            {
                <tr><td>@s.SaleId</td><td data-sort-value="@s.SaleDate.ToString("yyyy-MM-ddTHH:mm")">@s.SaleDate.ToString("MMM d, yyyy h:mm tt")</td><td>₱@s.TotalAmount.ToString("N2")</td></tr>
            }
        </tbody>
    </table>
}

<a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
