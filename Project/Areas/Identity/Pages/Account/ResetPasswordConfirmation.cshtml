@page
@model FabriTrack.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Password reset";
}

<div class="auth-card">
    <div class="d-flex align-items-center mb-3">
        <div class="brand-badge me-3"><i class="bi bi-scissors"></i></div>
        <div>
            <div class="brand-name">FabriTrack</div>
            <div class="brand-tag">Account recovery</div>
        </div>
    </div>

    <h2 class="h4">Password reset complete</h2>
    <p class="text-muted mb-3">If the reset link was valid, your password has been updated. You can now sign in with your new password.</p>
    <a asp-page="./Login" class="btn btn-primary w-100">Back to sign in</a>
</div>
