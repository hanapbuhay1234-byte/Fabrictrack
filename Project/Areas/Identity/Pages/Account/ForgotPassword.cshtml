@page
@model FabriTrack.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot password";
}

<div class="auth-card">
    <div class="d-flex align-items-center mb-3">
        <div class="brand-badge me-3"><i class="bi bi-scissors"></i></div>
        <div>
            <div class="brand-name">FabriTrack</div>
            <div class="brand-tag">Account recovery</div>
        </div>
    </div>

    <h2 class="h4">Forgot your password?</h2>
    <p class="text-muted mb-3">Enter the email address linked to your account. If it matches an account, we’ll send a password reset link.</p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" autofocus />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
    </form>

    <div class="mt-3 text-center small">
        <a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Back to sign in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
