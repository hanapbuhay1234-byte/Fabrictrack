@page
@model FabriTrack.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Check your email";
}

<div class="auth-card">
    <div class="d-flex align-items-center mb-3">
        <div class="brand-badge me-3"><i class="bi bi-scissors"></i></div>
        <div>
            <div class="brand-name">FabriTrack</div>
            <div class="brand-tag">Account recovery</div>
        </div>
    </div>

    <h2 class="h4">Check your email</h2>
    <p class="text-muted mb-3">If an account matches the address you entered, a password reset link will be sent. If it doesn’t arrive, contact your FabriTrack administrator.</p>
    <a asp-page="./Login" class="btn btn-primary w-100">Back to sign in</a>
</div>
