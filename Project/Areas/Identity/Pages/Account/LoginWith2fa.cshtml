@page
@model FabriTrack.Areas.Identity.Pages.Account.LoginWith2faModel
@{
    Layout = "/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Two-factor sign-in";
}

<div class="auth-card">
    <div class="d-flex align-items-center mb-3">
        <div class="brand-badge me-3"><i class="bi bi-scissors"></i></div>
        <div>
            <div class="brand-name">FabriTrack</div>
            <div class="brand-tag">Fabric Inventory &amp; Sales</div>
        </div>
    </div>
    <h2 class="h4">Verify your sign-in</h2>
    <p class="text-muted mb-3">Enter the code from your authenticator app.</p>
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input asp-for="Input.RememberMe" type="hidden" />
        <div class="mb-3">
            <label asp-for="Input.TwoFactorCode" class="form-label">Authenticator code</label>
            <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.TwoFactorCode" class="text-danger small"></span>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="Input.RememberMachine" class="form-check-input" />
            <label asp-for="Input.RememberMachine" class="form-check-label">Remember this machine</label>
        </div>
        <button type="submit" class="btn btn-auth-submit btn-lg w-100">Verify</button>
    </form>
</div>
